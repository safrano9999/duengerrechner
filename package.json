{
  "name": "duengerrechner",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "start": ".venv/bin/python scripts/start-baremetal.py",
    "start:container": "node src/launch.mjs",
    "start:api": "node src/node-api.mjs",
    "start:mcp": "node src/mcp-stdio.mjs",
    "test": "node --test tests/*.test.mjs",
    "worker:dev": "wrangler dev",
    "worker:check": "wrangler deploy --dry-run --config wrangler.example.jsonc",
    "worker:deploy": "wrangler deploy",
    "config:worker": "node scripts/config-worker.mjs"
  },
  "dependencies": {
    "@hono/node-server": "2.1.4",
    "@modelcontextprotocol/sdk": "1.32.1",
    "graphql": "17.0.2",
    "graphql-yoga": "5.24.4",
    "hono": "4.13.13",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "supergateway": "4.1.0",
    "wrangler": "4.149.0"
  }
}
