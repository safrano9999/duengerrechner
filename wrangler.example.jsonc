{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "duengerrechner",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-12",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "build": {"command": "node scripts/build-static.mjs"},
  "assets": {
    "directory": "./dist/site", "binding": "ASSETS",
    "run_worker_first": ["/api", "/api/*", "/graphql", "/mcp", "/health", "/backend.json"]
  },
  "vars": {"CORS_ORIGINS": "https://safrano9999.github.io"},
  "d1_databases": [{
    "binding": "DB", "database_name": "duengerrechner-profiles",
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "migrations"
  }]
}
