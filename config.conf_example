# Bare-metal listeners only. Container ports are fixed: API=8080, MCP=8000.
#when: DEPLOY_MODE=baremetal
#default-preset: 127.0.0.1
API_HOST=127.0.0.1

#when: DEPLOY_MODE=baremetal
#default-preset: 8080
API_PORT=8080

#when: DEPLOY_MODE=baremetal
#default-preset: 127.0.0.1
MCP_HOST=127.0.0.1

#when: DEPLOY_MODE=baremetal
#default-preset: 8000
MCP_PORT=8000

#when: DEPLOY_MODE=baremetal
#default-preset: ./data/profiles.sqlite
PROFILES_DB=./data/profiles.sqlite

# Comma-separated browser origins; exact scheme/host/port, no trailing slash.
#default-preset: https://safrano9999.github.io
CORS_ORIGINS=https://safrano9999.github.io

# Public button destinations. No credentials in these values.
PUBLIC_API_URL=https://duengerrechner.safrano9999.workers.dev/api

PUBLIC_MCP_URL=https://duengerrechner.safrano9999.workers.dev/mcp
